# ════════════════════════════════════════════════════════════
# EcoSensing AI — Environment Configuration Template
# Project: Urban Microclimate Observatory & Field Sentinel
# Author:  Ali Nihad Qadir (علي نهاد قادر)
# Institution: Middle Technical University — Polytechnic College
#              Dept. of Electronic & AI Engineering Technologies
#
# USAGE: Copy this file to .env and fill in your real values.
#        cp .env.example .env
#        NEVER commit the .env file to version control.
# ════════════════════════════════════════════════════════════

# ── Groq LPU Inference API ───────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_PRIMARY=your_groq_api_key_primary_here
GROQ_API_KEY_BACKUP=your_groq_api_key_backup_here

# ── Groq Model Selection ─────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ── LocationIQ Geocoding & Map Tiles ─────────────────────────
# Get your key at: https://locationiq.com/
LOCATIONIQ_API_KEY=your_locationiq_key_here

# ── Application Settings ─────────────────────────────────────
APP_ENV=development
PORT=8000
